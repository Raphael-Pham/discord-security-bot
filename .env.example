# ============================================================
# Discord Security Bot — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Discord Credentials ──────────────────────────────────────
# Your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Your application/client ID
DISCORD_CLIENT_ID=your_client_id_here

# (Optional) Restrict slash command registration to one guild during development.
# Remove or leave blank for global command registration.
DISCORD_GUILD_ID=your_guild_id_here

# ── Alert Channel Configuration ──────────────────────────────
# ID of the text channel that receives security alerts.
# If not set, the bot will attempt auto-discovery by channel name
# (looks for: security-alerts, alerts, security-log).
ALERT_CHANNEL_ID=your_alert_channel_id_here

# ── Voice Monitoring Settings ────────────────────────────────
# Seconds before an alert fires after users enter a voice channel.
# Default: 60 (1 minute)
ALERT_DELAY_SECONDS=60

# Comma-separated list of voice channel IDs to ignore (optional).
# Example: IGNORED_CHANNEL_IDS=123456789,987654321
IGNORED_CHANNEL_IDS=

# Comma-separated list of role IDs whose members are never flagged (optional).
IGNORED_ROLE_IDS=

# Comma-separated list of user IDs that are never flagged (optional).
IGNORED_USER_IDS=

# ── Database ─────────────────────────────────────────────────
# SQLite (local dev / Render persistent disk):
DATABASE_URL="file:./data/bot.db"

# PostgreSQL (Neon / Supabase free tier example):
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ── Logging ──────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Set to "true" to enable pretty-printed logs (dev only; disable in prod for JSON output).
LOG_PRETTY=false

# ── Optional Webhook Forwarding ──────────────────────────────
# Forward alerts to an external Discord webhook URL (optional).
ALERT_WEBHOOK_URL=

# Forward alerts to a Slack incoming webhook URL (optional).
SLACK_WEBHOOK_URL=

# ── Health-check HTTP Server ─────────────────────────────────
# Port for the lightweight keep-alive HTTP server.
# Required on Render / Koyeb to prevent the instance from sleeping.
PORT=3000

# ── Node Environment ─────────────────────────────────────────
NODE_ENV=production
